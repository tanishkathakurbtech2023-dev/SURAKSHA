APP_ENV=development
SURAKSHA_API_KEY=replace_with_strong_secret
CORS_ORIGINS=http://localhost:8000

# base64 of exactly 32 bytes for AES-256-GCM
ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# PEM keys for ECDSA signing/verification
ECDSA_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
ECDSA_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

SQLITE_DB_PATH=suraksha.db
DATABASE_URL=postgresql://user:password@localhost:5432/suraksha
MONGODB_URI=mongodb://localhost:27017/suraksha
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace_me
SMS_GATEWAY_API_KEY=replace_me
